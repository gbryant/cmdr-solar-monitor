# ESP-IDF build output
/build-esp32/
# generated sdkconfig (sdkconfig.defaults is the committed source of truth)
/sdkconfig
/sdkconfig.old

# cmdr-generated convenience wrappers around idf.py (regenerated by cmdr)
/bum
/build
/upload
/monitor
/bum-ota

# WiFi credentials — copy secrets.h.example to secrets.h and fill in
/secrets.h

# logged sensor data (the poller appends to it) + its backup; runtime data,
# preserved on disk but kept out of git to avoid committing a growing binary
/solar.db
/solar.db.zip

# local build counter (version stamp) and OS / Python cruft
/.build_number
__pycache__/
.DS_Store
